<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>お弁当発注アプリ - カレンダー入力</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6;
        }
    </style>
</head>
<body class="min-h-screen p-4 sm:p-6 lg:p-8 flex justify-center items-start">

    <div class="w-full max-w-5xl space-y-6">
        <header class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 text-center">
            <h1 class="text-2xl font-bold text-gray-800 flex items-center justify-center gap-2">
                🍱 お弁当発注システム（クラウド同期版）
            </h1>
            <p class="text-gray-500 text-sm mt-1">名前を選んで、1ヶ月のカレンダーから日付ごとにメニューを選んでクラウドに保存できます</p>
            <div id="authStatus" class="text-xs text-orange-600 mt-2 font-medium">接続中...</div>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- フォームセクション（カレンダー入力） -->
            <section class="lg:col-span-7 bg-white rounded-2xl p-6 shadow-sm border border-gray-100 h-fit">
                <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
                    📅 1ヶ月メニュー入力
                </h2>

                <div class="space-y-4 mb-6">
                    <div>
                        <label for="userNameSelect" class="block text-sm font-medium text-gray-700 mb-1">お名前を選択 <span class="text-red-500">*</span></label>
                        <select id="userNameSelect" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition text-gray-800 bg-white">
                            <option value="" disabled selected>お名前を選択してください</option>
                            <option value="徳井">徳井</option>
                            <option value="木下">木下</option>
                            <option value="周防">周防</option>
                            <option value="中島">中島</option>
                            <option value="森">森</option>
                            <option value="__custom__">直接入力（自由記述）</option>
                        </select>
                    </div>

                    <div id="customNameContainer" class="hidden">
                        <label for="userNameCustom" class="block text-sm font-medium text-gray-700 mb-1">お名前（直接入力） <span class="text-red-500">*</span></label>
                        <input type="text" id="userNameCustom" placeholder="例: 山田 太郎" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition text-gray-800">
                    </div>

                    <!-- 月切り替えヘッダー -->
                    <div class="flex items-center justify-between bg-orange-50 p-3 rounded-xl">
                        <button type="button" id="prevMonthBtn" class="p-1.5 hover:bg-orange-200 rounded-lg text-orange-700 transition">◀ 前の月</button>
                        <span id="currentMonthLabel" class="font-bold text-orange-800 text-base">2026年10月</span>
                        <button type="button" id="nextMonthBtn" class="p-1.5 hover:bg-orange-200 rounded-lg text-orange-700 transition">次の月 ▶</button>
                    </div>

                    <!-- メニュー説明 -->
                    <div class="text-xs text-gray-500 bg-gray-50 p-3 rounded-lg border border-gray-200 space-y-1">
                        <p class="font-medium text-gray-700">📌 入力ヒント</p>
                        <p>・<span class="font-bold text-orange-600">-</span> : 注文なし</p>
                        <p>・<span class="font-bold text-orange-600">1</span> (おかず・ごはん)</p>
                        <p>・<span class="font-bold text-orange-600">2</span> (おかずのみ)</p>
                    </div>
                </div>

                <div id="calendarContainer" class="opacity-50 pointer-events-none transition">
                    <div class="grid grid-cols-7 gap-1 text-center font-semibold text-xs text-gray-500 mb-2">
                        <span class="text-red-500">日</span><span>月</span><span>火</span><span>水</span><span>木</span><span>金</span><span class="text-blue-500">土</span>
                    </div>
                    <div id="calendarDaysGrid" class="grid grid-cols-7 gap-1.5">
                        <!-- ical/calendar days injected by JS -->
                    </div>

                    <button id="saveCalendarBtn" type="button" class="w-full mt-6 bg-orange-500 hover:bg-orange-600 text-white font-semibold py-2.5 px-4 rounded-lg shadow transition duration-200 active:scale-95 flex items-center justify-center gap-2">
                        <span>この内容で注文を保存する</span>
                    </button>
                </div>
                
                <div id="calendarPrompt" class="text-center py-8 text-orange-600 text-sm font-medium bg-orange-50/50 rounded-xl border border-dashed border-orange-200">
                    ⬆️ 上部でお名前を選択すると、カレンダーが表示されます。
                </div>
            </section>

            <section class="lg:col-span-5 bg-white rounded-2xl p-6 shadow-sm border border-gray-100 h-fit">
                <div class="flex items-center justify-between mb-4 pb-2 border-b border-gray-100 gap-2">
                    <h2 class="text-lg font-semibold text-gray-800 flex items-center gap-2">
                        📋 注文一覧
                    </h2>
                    <div class="flex items-center gap-2">
                        <span id="totalCount" class="text-xs bg-orange-100 text-orange-700 px-2.5 py-1 rounded-full font-medium whitespace-nowrap">合計: 0件</span>
                        <button id="openCsvModalBtn" type="button" class="bg-green-600 hover:bg-green-700 text-white text-xs font-semibold py-1.5 px-3 rounded-lg shadow transition duration-200 flex items-center gap-1 active:scale-95">
                            <span>📥 CSV出力</span>
                        </button>
                    </div>
                </div>

                <!-- 検索フィルターエリア -->
                <div class="mb-4">
                    <label for="searchNameSelect" class="block text-xs font-medium text-gray-700 mb-1">お名前で絞り込み</label>
                    <select id="searchNameSelect" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition text-gray-800 bg-white">
                        <option value="">すべて表示</option>
                        <option value="徳井">徳井</option>
                        <option value="木下">木下</option>
                        <option value="周防">周防</option>
                        <option value="中島">中島</option>
                        <option value="森">森</option>
                    </select>
                </div>

                <div class="overflow-x-auto max-h-[450px] overflow-y-auto">
                    <table class="w-full text-left text-sm text-gray-600">
                        <thead class="bg-gray-50 text-gray-700 uppercase text-xs sticky top-0">
                            <tr>
                                <th class="py-2.5 px-3">対象日</th>
                                <th class="py-2.5 px-3">名前</th>
                                <th class="py-2.5 px-3">メニュー</th>
                                <th class="py-2.5 px-3">登録日時</th>
                                <th class="py-2.5 px-3 text-right">操作</th>
                            </tr>
                        </thead>
                        <tbody id="orderTableBody" class="divide-y divide-gray-100">
                            <!-- JS will inject rows here -->
                        </tbody>
                    </table>
                </div>

                <div id="emptyState" class="text-center py-8 text-gray-400 text-sm">
                    注文データがまだありません。カレンダーから入力してください。
                </div>
            </section>
        </div>
    </div>

    <!-- CSV出力モーダル -->
    <div id="csvModal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl p-6 w-full max-w-md shadow-xl space-y-4">
            <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                📥 月別CSV出力（行列反転）
            </h3>
            <p class="text-xs text-gray-500">出力したい月を選択してください。行に名前、列に日付が並んだ形式でダウンロードできます（メニューは1・2の数字）。</p>
            
            <div>
                <label for="csvMonthSelect" class="block text-sm font-medium text-gray-700 mb-1">対象月を選択</label>
                <select id="csvMonthSelect" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none transition text-gray-800 bg-white">
                    <!-- 選択肢はJSで動的に生成 -->
                </select>
            </div>

            <div class="flex items-center justify-end gap-2 pt-2">
                <button id="closeCsvModalBtn" type="button" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 text-sm font-medium transition">
                    キャンセル
                </button>
                <button id="confirmCsvDownloadBtn" type="button" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg text-sm font-semibold shadow transition active:scale-95">
                    CSVをダウンロード
                </button>
            </div>
        </div>
    </div>

    <!-- カスタムメッセージモーダル -->
    <div id="messageModal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl p-6 w-full max-w-sm shadow-xl space-y-4 text-center">
            <p id="modalMessageText" class="text-gray-800 text-sm font-medium"></p>
            <button id="closeModalBtn" type="button" class="w-full bg-orange-500 hover:bg-orange-600 text-white font-semibold py-2 px-4 rounded-lg transition">
                OK
            </button>
        </div>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, doc, setDoc, deleteDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Firebase configuration and initialization
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};

        let app, db, auth;
        let orders = [];
        let currentYear = new Date().getFullYear();
        let currentMonth = new Date().getMonth();

        // DOM Elements
        const authStatus = document.getElementById('authStatus');
        const userNameSelect = document.getElementById('userNameSelect');
        const customNameContainer = document.getElementById('customNameContainer');
        const userNameCustomInput = document.getElementById('userNameCustom');
        const prevMonthBtn = document.getElementById('prevMonthBtn');
        const nextMonthBtn = document.getElementById('nextMonthBtn');
        const currentMonthLabel = document.getElementById('currentMonthLabel');
        const calendarContainer = document.getElementById('calendarContainer');
        const calendarPrompt = document.getElementById('calendarPrompt');
        const calendarDaysGrid = document.getElementById('calendarDaysGrid');
        const saveCalendarBtn = document.getElementById('saveCalendarBtn');
        
        const searchNameSelect = document.getElementById('searchNameSelect');
        const openCsvModalBtn = document.getElementById('openCsvModalBtn');
        const csvModal = document.getElementById('csvModal');
        const closeCsvModalBtn = document.getElementById('closeCsvModalBtn');
        const confirmCsvDownloadBtn = document.getElementById('confirmCsvDownloadBtn');
        const csvMonthSelect = document.getElementById('csvMonthSelect');
        const orderTableBody = document.getElementById('orderTableBody');
        const emptyState = document.getElementById('emptyState');
        const totalCount = document.getElementById('totalCount');
        
        const messageModal = document.getElementById('messageModal');
        const modalMessageText = document.getElementById('modalMessageText');
        const closeModalBtn = document.getElementById('closeModalBtn');

        function showCustomAlert(msg) {
            modalMessageText.textContent = msg;
            messageModal.classList.remove('hidden');
        }

        closeModalBtn.addEventListener('click', () => {
            messageModal.classList.add('hidden');
        });

        // Initialize Firebase and Auth
        async function initFirebase() {
            try {
                app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);

                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }

                onAuthStateChanged(auth, (user) => {
                    if (user) {
                        authStatus.textContent = '● クラウド接続完了';
                        setupRealtimeListener();
                    } else {
                        authStatus.textContent = '○ 認証待機中...';
                    }
                });
            } catch (err) {
                console.error("Firebase initialization error:", err);
                authStatus.textContent = '⚠️ クラウド接続エラー（ローカルモード）';
            }
        }

        // Realtime listener for Firestore public collection
        function setupRealtimeListener() {
            if (!db) return;
            const ordersCol = collection(db, 'artifacts', appId, 'public', 'data', 'orders');
            
            onSnapshot(ordersCol, (snapshot) => {
                orders = [];
                snapshot.forEach(docSnap => {
                    orders.push({ id: docSnap.id, ...docSnap.data() });
                });
                renderOrders();
                renderCalendar();
            }, (error) => {
                console.error("Firestore snapshot error:", error);
            });
        }

        // Toggle custom name input visibility
        userNameSelect.addEventListener('change', (e) => {
            if (e.target.value === '__custom__') {
                customNameContainer.classList.remove('hidden');
                userNameCustomInput.required = true;
            } else {
                customNameContainer.classList.add('hidden');
                userNameCustomInput.required = false;
                userNameCustomInput.value = '';
            }
            checkCalendarReady();
        });

        function checkCalendarReady() {
            const val = userNameSelect.value;
            const customVal = userNameCustomInput.value.trim();
            const isReady = (val && val !== '__custom__') || (val === '__custom__' && customVal.length > 0);

            if (isReady) {
                calendarContainer.classList.remove('opacity-50', 'pointer-events-none');
                calendarPrompt.classList.add('hidden');
                renderCalendar();
            } else {
                calendarContainer.classList.add('opacity-50', 'pointer-events-none');
                calendarPrompt.classList.remove('hidden');
            }
        }

        userNameCustomInput.addEventListener('input', () => {
            checkCalendarReady();
        });

        prevMonthBtn.addEventListener('click', () => {
            currentMonth--;
            if (currentMonth < 0) {
                currentMonth = 11;
                currentYear--;
            }
            renderCalendar();
        });

        nextMonthBtn.addEventListener('click', () => {
            currentMonth++;
            if (currentMonth > 11) {
                currentMonth = 0;
                currentYear++;
            }
            renderCalendar();
        });

        function renderCalendar() {
            currentMonthLabel.textContent = `${currentYear}年${currentMonth + 1}月`;
            calendarDaysGrid.innerHTML = '';

            const firstDayIndex = new Date(currentYear, currentMonth, 1).getDay();
            const lastDay = new Date(currentYear, currentMonth + 1, 0).getDate();

            let activeName = userNameSelect.value === '__custom__' ? userNameCustomInput.value.trim() : userNameSelect.value;

            for (let i = 0; i < firstDayIndex; i++) {
                const emptyCell = document.createElement('div');
                calendarDaysGrid.appendChild(emptyCell);
            }

            for (let day = 1; day <= lastDay; day++) {
                const monthStr = String(currentMonth + 1).padStart(2, '0');
                const dayStr = String(day).padStart(2, '0');
                const dateStr = `${currentYear}-${monthStr}-${dayStr}`;

                const existingOrder = orders.find(o => o.date === dateStr && o.name === activeName);
                let currentMenuValue = '';
                if (existingOrder) {
                    if (existingOrder.menu === 'おかず・ごはん') currentMenuValue = '1';
                    else if (existingOrder.menu === 'おかずのみ') currentMenuValue = '2';
                }

                const dayCell = document.createElement('div');
                dayCell.className = 'flex flex-col items-center bg-gray-50 p-1.5 rounded-lg border border-gray-200';
                
                const isWeekend = new Date(currentYear, currentMonth, day).getDay();
                let dayColor = 'text-gray-800';
                if (isWeekend === 0) dayColor = 'text-red-500 font-bold';
                if (isWeekend === 6) dayColor = 'text-blue-500 font-bold';

                dayCell.innerHTML = `
                    <span class="text-xs font-semibold ${dayColor} mb-1">${day}</span>
                    <select data-date="${dateStr}" class="day-menu-select w-full text-xs p-1 border border-gray-300 rounded bg-white text-center focus:ring-1 focus:ring-orange-500 outline-none">
                        <option value="" ${currentMenuValue === '' ? 'selected' : ''}>-</option>
                        <option value="1" ${currentMenuValue === '1' ? 'selected' : ''}>1: おかず・ごはん</option>
                        <option value="2" ${currentMenuValue === '2' ? 'selected' : ''}>2: おかずのみ</option>
                    </select>
                `;

                calendarDaysGrid.appendChild(dayCell);
            }
        }

        // Save Calendar Orders to Firestore
        saveCalendarBtn.addEventListener('click', async () => {
            let activeName = userNameSelect.value === '__custom__' ? userNameCustomInput.value.trim() : userNameSelect.value;
            if (!activeName) {
                showCustomAlert('お名前を入力・選択してください。');
                return;
            }

            const selects = calendarDaysGrid.querySelectorAll('.day-menu-select');
            const monthPrefix = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}`;
            const nowTimestamp = new Date().toISOString();

            if (!db) {
                showCustomAlert('クラウド接続が初期化されていません。');
                return;
            }

            try {
                // Delete existing records for this user in this month first
                const targetOrders = orders.filter(o => o.name === activeName && o.date.startsWith(monthPrefix));
                for (const ord of targetOrders) {
                    await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'orders', ord.id));
                }

                let addedCount = 0;
                for (const select of selects) {
                    const date = select.getAttribute('data-date');
                    const val = select.value;
                    if (val) {
                        let menuText = val === '1' ? 'おかず・ごはん' : 'おかずのみ';
                        const uniqueDocId = `${activeName}_${date}`.replace(/[\s\/]/g, '_');
                        await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'orders', uniqueDocId), {
                            date: date,
                            name: activeName,
                            menu: menuText,
                            createdAt: nowTimestamp
                        });
                        addedCount++;
                    }
                }

                showCustomAlert(`${activeName}さんの ${currentYear}年${currentMonth + 1}月の発注内容をクラウドに保存しました！（${addedCount}件）`);
            } catch (err) {
                console.error("Save error:", err);
                showCustomAlert('保存中にエラーが発生しました。');
            }
        });

        openCsvModalBtn.addEventListener('click', () => {
            csvMonthSelect.innerHTML = '';
            const monthsSet = new Set();
            orders.forEach(o => {
                if (o.date) monthsSet.add(o.date.slice(0, 7));
            });

            const currentYm = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}`;
            monthsSet.add(currentYm);

            const sortedMonths = Array.from(monthsSet).sort();
            sortedMonths.forEach(ym => {
                const [y, m] = ym.split('-');
                const option = document.createElement('option');
                option.value = ym;
                option.textContent = `${y}年${parseInt(m)}月`;
                if (ym === currentYm) option.selected = true;
                csvMonthSelect.appendChild(option);
            });

            csvModal.classList.remove('hidden');
        });

        closeCsvModalBtn.addEventListener('click', () => {
            csvModal.classList.add('hidden');
        });

        csvModal.addEventListener('click', (e) => {
            if (e.target === csvModal) csvModal.classList.add('hidden');
        });

        confirmCsvDownloadBtn.addEventListener('click', () => {
            const selectedYm = csvMonthSelect.value;
            if (!selectedYm) return;

            const [yearStr, monthStr] = selectedYm.split('-');
            const year = parseInt(yearStr);
            const month = parseInt(monthStr);
            const lastDay = new Date(year, month, 0).getDate();

            const monthOrders = orders.filter(o => o.date && o.date.startsWith(selectedYm));
            const defaultNames = ['徳井', '木下', '周防', '中島', '森'];
            const namesSet = new Set(defaultNames);
            orders.forEach(o => { if (o.name) namesSet.add(o.name); });
            const namesList = Array.from(namesSet);

            let csvRows = [];
            let headerCols = ['名前'];
            for (let day = 1; day <= lastDay; day++) {
                headerCols.push(`${day}日`);
            }
            csvRows.push(headerCols.map(c => `"${c}"`).join(','));

            namesList.forEach(name => {
                let rowData = [name];
                for (let day = 1; day <= lastDay; day++) {
                    const dayStr = String(day).padStart(2, '0');
                    const dateStr = `${selectedYm}-${dayStr}`;
                    const found = monthOrders.find(o => o.name === name && o.date === dateStr);
                    let menuVal = '';
                    if (found) {
                        menuVal = found.menu === 'おかず・ごはん' ? '1' : (found.menu === 'おかずのみ' ? '2' : found.menu);
                    }
                    rowData.push(menuVal);
                }
                csvRows.push(rowData.map(c => `"${c}"`).join(','));
            });

            const csvContent = '\uFEFF' + csvRows.join('\n');
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `お弁当発注一覧_${year}年${month}月.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);

            csvModal.classList.add('hidden');
        });

        searchNameSelect.addEventListener('change', () => {
            renderOrders();
        });

        window.deleteOrder = async function(id) {
            if (!db) return;
            try {
                await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'orders', id));
            } catch (err) {
                console.error("Delete error:", err);
                showCustomAlert('削除中にエラーが発生しました。');
            }
        };

        function updateSearchNameOptions() {
            const currentSelected = searchNameSelect.value;
            const defaultNames = ['徳井', '木下', '周防', '中島', '森'];
            const namesSet = new Set(defaultNames);
            orders.forEach(o => { if (o.name) namesSet.add(o.name); });

            searchNameSelect.innerHTML = '<option value="">すべて表示</option>';
            Array.from(namesSet).sort().forEach(name => {
                const opt = document.createElement('option');
                opt.value = name;
                opt.textContent = name;
                if (name === currentSelected) opt.selected = true;
                searchNameSelect.appendChild(opt);
            });
        }

        function renderOrders() {
            updateSearchNameOptions();
            const selectedSearchName = searchNameSelect.value;
            
            let filteredOrders = orders;
            if (selectedSearchName) {
                filteredOrders = orders.filter(o => o.name === selectedSearchName);
            }

            filteredOrders.sort((a, b) => {
                if (a.date !== b.date) return b.date.localeCompare(a.date);
                return (a.name || '').localeCompare(b.name || '');
            });

            orderTableBody.innerHTML = '';
            totalCount.textContent = `合計: ${filteredOrders.length}件`;

            if (filteredOrders.length === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
                filteredOrders.forEach(order => {
                    const tr = document.createElement('tr');
                    tr.className = 'hover:bg-gray-50 transition border-b border-gray-50';

                    let formattedTime = '-';
                    if (order.createdAt) {
                        const d = new Date(order.createdAt);
                        if (!isNaN(d.getTime())) {
                            const y = d.getFullYear();
                            const m = String(d.getMonth() + 1).padStart(2, '0');
                            const day = String(d.getDate()).padStart(2, '0');
                            const h = String(d.getHours()).padStart(2, '0');
                            const min = String(d.getMinutes()).padStart(2, '0');
                            formattedTime = `${y}/${m}/${day} ${h}:${min}`;
                        }
                    }

                    tr.innerHTML = `
                        <td class="py-2.5 px-3 font-medium text-gray-800">${order.date}</td>
                        <td class="py-2.5 px-3 text-gray-700">${order.name}</td>
                        <td class="py-2.5 px-3 text-gray-700">
                            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold ${order.menu === 'おかず・ごはん' ? 'bg-orange-100 text-orange-800' : 'bg-blue-100 text-blue-800'}">
                                ${order.menu}
                            </span>
                        </td>
                        <td class="py-2.5 px-3 text-xs text-gray-400">${formattedTime}</td>
                        <td class="py-2.5 px-3 text-right">
                            <button type="button" onclick="deleteOrder('${order.id}')" class="text-red-500 hover:text-red-700 text-xs px-2 py-1 bg-red-50 hover:bg-red-100 rounded transition font-medium">削除</button>
                        </td>
                    `;
                    orderTableBody.appendChild(tr);
                });
            }
        }

        // Run Firebase Initialization on load
        window.onload = function() {
            initFirebase();
        };
    </script>
</body>
</html>
